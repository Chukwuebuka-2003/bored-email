# ===== Email (Gmail) =====
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-app-password
TEAM_RECIPIENTS=you@gmail.com,partner@example.com

# ===== Local LLM (LM Studio) =====
# LM Studio exposes an OpenAI-compatible API at http://localhost:1234/v1
# while a model is loaded. No API key is needed — email content never leaves
# your machine.
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
# Set this to the model identifier shown in LM Studio (e.g. "llama-3.2-3b-instruct").
OPENAI_MODEL=local-model
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=300

# ===== Digest settings =====
MORNING_CUTOFF_HOURS=12
EVENING_CUTOFF_HOURS=12
MORNING_SCHEDULE=0 7 * * *
EVENING_SCHEDULE=0 21 * * *
MAX_EMAILS_PER_DIGEST=50
